filters:
  and:
    - file.ext == "md"
    - type == "capture"
properties:
  file.name:
    displayName: 记录
  note.status:
    displayName: 状态
  note.scene:
    displayName: 场景
  note.date:
    displayName: 日期
views:
  - type: table
    name: 全部记录
    order:
      - file.name
      - note.scene
      - note.status
      - note.date
